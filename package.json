{
  "name": "mergestorm",
  "version": "0.3.17",
  "description": "Mergestorm CLI (mg) — local reviews & stacked PRs. MIT; build from source: https://github.com/marginsystems/mergestorm-cli",
  "license": "MIT",
  "type": "module",
  "author": "Margin Systems <hello@mergestorm.ai>",
  "keywords": [
    "mergestorm",
    "code-review",
    "cli",
    "git",
    "pull-request",
    "stacked-prs",
    "review"
  ],
  "bin": {
    "mergestorm": "./dist/cli.js",
    "mg": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js",
    "./client": "./dist/client/index.js"
  },
  "homepage": "https://mergestorm.ai/docs#review-jobs-api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marginsystems/mergestorm-cli.git"
  },
  "bugs": {
    "url": "https://github.com/marginsystems/mergestorm-cli/issues"
  },
  "files": [
    "dist",
    "skill",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && node dist/cli.js --version"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
